#version 450
#extension GL_GOOGLE_include_directive : require
#include "df64_ops.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer A { vec2 a[]; };
layout(std430, binding = 1) readonly buffer B { vec2 b[]; };
layout(std430, binding = 2) writeonly buffer R { vec2 r[]; };
layout(push_constant) uniform P { uint n; uint op; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    vec2 x = a[i], y = b[i], z;
    if (pc.op == 0u) z = dfAdd(x, y);
    else if (pc.op == 1u) z = dfMul(x, y);
    else if (pc.op == 2u) z = dfDiv(x, y);
    else z = dfSqrt(x);
    r[i] = z;
}
