#version 450
#include "sum_common.glsl"
layout(std430, binding = 0) readonly buffer In { uvec2 x[]; };  // raw IEEE double bits (x = low word, y = high word)

#include "split_double.glsl"

void main() {
    vec2 acc[kMaxGroups];
    for (uint k = 0u; k < GROUPS; k++) acc[k] = vec2(0.0);
    uint bad = 0u;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += pc.stride) {
        uint g = 0u;
        if (GROUPS > 1u) { g = gid[i]; if (g >= GROUPS) { g = 0u; bad = 1u; } }
        acc[g] = dfAdd(acc[g], splitDouble(x[i], bad));
    }
    reduceAndStore(acc, bad);
}
