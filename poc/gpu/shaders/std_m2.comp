#version 450
// POC 9 pass 2: per group, sum of (x - mean)^2 in df64. The mean comes from pass 1 (the `$sum` kernel) via the host,
// so every partial is relative to the global mean and the partials just add; no Chan merge correction is needed.
#include "sum_common.glsl"
layout(std430, binding = 0) readonly buffer In { uvec2 x[]; };  // raw IEEE double bits
layout(std430, binding = 4) readonly buffer Means { vec2 mean[]; };
#include "split_double.glsl"

void main() {
    vec2 acc[kMaxGroups];
    for (uint k = 0u; k < GROUPS; k++) acc[k] = vec2(0.0);
    uint bad = 0u;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += pc.stride) {
        uint g = 0u;
        if (GROUPS > 1u) { g = gid[i]; if (g >= GROUPS) { g = 0u; bad = 1u; } }
        vec2 d = dfAdd(splitDouble(x[i], bad), dfNeg(mean[g]));
        float a = abs(d.x);
        // d*d must neither overflow float32 nor lose its low word to underflow: such data goes to the CPU path.
        if (a > 1e18 || (a != 0.0 && a < 1e-15)) bad = 1u;
        acc[g] = dfAdd(acc[g], dfMul(d, d));
    }
    reduceAndStore(acc, bad);
}
