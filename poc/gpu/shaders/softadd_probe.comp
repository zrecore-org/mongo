#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// POC 12: device probe for f64_add. Input pairs of binary64 bit patterns, output their integer-arithmetic sum.
#include "f64soft.inc"
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { uint64_t ab[]; };
layout(std430, binding = 1) writeonly buffer Out { uint64_t r[]; };
layout(push_constant) uniform P { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    r[i] = f64_add(ab[2u * i], ab[2u * i + 1u]);
}
